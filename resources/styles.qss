/*
 * BelEye — global QSS
 * Modern dark theme inspired by Linear / Vercel / shadcn:
 *   - tight neutral palette, single blue accent
 *   - small rounded corners (6-8px)
 *   - subtle 1px borders instead of heavy strokes
 *   - low chroma backgrounds, lots of breathing room
 */

QMainWindow, QDialog, QWidget {
    background-color: #0b0d10;
    color: #e5e7eb;
    font-family: "Inter", "SF Pro Display", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* ---------- Toolbar ---------- */

QToolBar {
    background: #0f1115;
    border: none;
    border-bottom: 1px solid #1a1d22;
    spacing: 2px;
    padding: 6px 10px;
}

QToolBar QToolButton {
    background: transparent;
    color: #cbd5e1;
    padding: 6px 12px;
    margin: 0 1px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    /* Pulls the icon graphic tighter to the text — QToolButton
       leaves a small gap (default 4 px) that varies between styles. */
}
QToolBar QToolButton:hover {
    background: #1a1d22;
    color: #ffffff;
}
QToolBar QToolButton:pressed {
    background: #1f242b;
}
QToolBar QToolButton:disabled {
    color: #475569;
}
QToolBar::separator {
    background: #1a1d22;
    width: 1px;
    margin: 6px 8px;
}

/* ---------- Status bar ---------- */

QStatusBar {
    background: #0f1115;
    color: #94a3b8;
    border-top: 1px solid #1a1d22;
    padding: 0 8px;
    font-size: 12px;
}

/* ---------- Buttons (generic) ---------- */

QPushButton {
    background: #1a1d22;
    color: #e5e7eb;
    border: 1px solid #1f242b;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background: #1f242b;
    border-color: #2a3038;
}
QPushButton:pressed {
    background: #15181d;
}
QPushButton:disabled {
    color: #475569;
    background: #13161c;
    border-color: #1a1d22;
}

/* Primary button uses [primary=true] property */
QPushButton[primary="true"] {
    background: #3b82f6;
    color: #ffffff;
    border-color: #3b82f6;
}
QPushButton[primary="true"]:hover {
    background: #2563eb;
    border-color: #2563eb;
}
QPushButton[primary="true"]:pressed {
    background: #1d4ed8;
}

QPushButton[danger="true"] {
    background: transparent;
    color: #f87171;
    border-color: #2a1f24;
}
QPushButton[danger="true"]:hover {
    background: #2a1518;
    color: #fca5a5;
    border-color: #3a1f25;
}

/* ---------- Inputs ---------- */

QLineEdit, QSpinBox, QComboBox {
    background: #13161c;
    color: #e5e7eb;
    border: 1px solid #1f242b;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 12px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #3b82f6;
    background: #15181d;
}
QLineEdit:disabled {
    color: #64748b;
    background: #0f1115;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: #13161c;
    color: #e5e7eb;
    border: 1px solid #1f242b;
    border-radius: 6px;
    selection-background-color: #1f242b;
    padding: 4px;
    outline: none;
}

/* ---------- Lists ---------- */

QListWidget {
    background: #0f1115;
    border: 1px solid #1a1d22;
    border-radius: 8px;
    padding: 6px;
    font-size: 13px;
    outline: none;
}
QListWidget::item {
    padding: 9px 10px;
    border-radius: 5px;
    color: #cbd5e1;
}
QListWidget::item:hover {
    background: #15181d;
    color: #ffffff;
}
QListWidget::item:selected {
    background: #1a3a6b;
    color: #ffffff;
}

/* ---------- Menus ---------- */

QMenu {
    background: #0f1115;
    border: 1px solid #1f242b;
    border-radius: 8px;
    padding: 5px;
    font-size: 12px;
}
QMenu::item {
    padding: 7px 18px 7px 14px;
    border-radius: 5px;
    color: #cbd5e1;
}
QMenu::item:selected {
    background: #1a1d22;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #1a1d22;
    margin: 4px 6px;
}

/* ---------- Labels ---------- */

QLabel {
    color: #e5e7eb;
}

/* ---------- Scroll bars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #2a3038;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #3a4250;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #2a3038;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #3a4250;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Dialog ---------- */

QDialog {
    background: #0b0d10;
}
QDialogButtonBox QPushButton {
    min-width: 84px;
}
